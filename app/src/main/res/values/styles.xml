<resources>
    <style name="Theme.Focus" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/focus_primary</item>
        <item name="colorPrimaryVariant">@color/focus_primary_variant</item>
        <item name="colorSecondary">@color/focus_secondary</item>
        <item name="colorSecondaryVariant">#3FAE8C</item>
        <item name="colorError">@color/focus_error</item>
        <item name="colorOnPrimary">#071923</item>
        <item name="colorSurface">@color/focus_surface</item>
        <item name="colorOnSurface">@color/focus_on_surface</item>
        <item name="colorOnBackground">@color/focus_on_surface</item>
        <item name="android:colorBackground">@color/focus_background</item>
        <item name="materialCardViewStyle">@style/Widget.Focus.Card</item>
        <item name="textInputStyle">@style/Widget.Focus.TextInputLayout</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#111318</item>
        <item name="android:navigationBarColor">#111318</item>
        <item name="android:windowBackground">@color/focus_background</item>
        <item name="android:fontFamily">@font/vazirmatn_regular</item>
        <item name="fontFamily">@font/vazirmatn_regular</item>
        <item name="shapeAppearanceSmallComponent">@style/Shape.Focus.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/Shape.Focus.Medium</item>
        <item name="materialButtonStyle">@style/Widget.Focus.Button</item>
    </style>

    <style name="Shape.Focus.Small" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">4dp</item>
    </style>

    <style name="Shape.Focus.Medium" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <style name="Widget.Focus.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">4dp</item>
    </style>

    <style name="Widget.Focus.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">8dp</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/focus_outline</item>
    </style>

    <style name="Widget.Focus.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.FilledBox">
        <item name="boxBackgroundColor">@color/focus_surface_raised</item>
        <item name="boxStrokeColor">@color/focus_primary</item>
        <item name="boxCornerRadiusTopStart">4dp</item>
        <item name="boxCornerRadiusTopEnd">4dp</item>
        <item name="boxCornerRadiusBottomStart">4dp</item>
        <item name="boxCornerRadiusBottomEnd">4dp</item>
        <item name="hintTextColor">@color/focus_on_surface_muted</item>
    </style>

    <style name="Widget.Focus.BottomNavigationView" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="itemIconTint">@color/navigation_item_tint</item>
        <item name="itemTextColor">@color/navigation_item_tint</item>
        <item name="itemBackground">@color/navigation_item_background</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.Focus.Navigation.Active</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.Focus.Navigation.Inactive</item>
        <item name="itemHorizontalTranslationEnabled">false</item>
    </style>

    <style name="TextAppearance.Focus.Navigation.Active" parent="TextAppearance.MaterialComponents.Caption">
        <item name="fontFamily">@font/vazirmatn_medium</item>
        <item name="android:fontFamily">@font/vazirmatn_medium</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="TextAppearance.Focus.Navigation.Inactive" parent="TextAppearance.MaterialComponents.Caption">
        <item name="fontFamily">@font/vazirmatn_regular</item>
        <item name="android:fontFamily">@font/vazirmatn_regular</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="Widget.Focus.IconButton" parent="Widget.MaterialComponents.Button">
        <item name="android:minWidth">40dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="iconSize">20dp</item>
    </style>
</resources>
